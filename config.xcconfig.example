// Copy this file to config.xcconfig and fill in real values.
// config.xcconfig is gitignored — never commit real credentials.

// From the Wearables Developer Center (wearables.developer.meta.com) app registration
META_APP_ID = your-meta-app-id
CLIENT_TOKEN = your-client-token

// Your Apple Developer Team ID (Xcode > Settings > Accounts)
DEVELOPMENT_TEAM = your-apple-team-id

// OpenAI API key with access to the Whisper transcription endpoint
WHISPER_API_KEY = your-openai-api-key

// API key for the chat/assistant provider (currently OpenAI; swap providers later
// without renaming this). For testing, duplicating the Whisper key above is fine.
ASSISTANT_API_KEY = your-assistant-api-key
